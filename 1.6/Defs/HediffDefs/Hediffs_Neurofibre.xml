<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>Tolgrim_MechNeurofibre</defName>
    <hediffClass>Hediff_Level</hediffClass>
    <descriptionHyperlinks><ThingDef>Tolgrim_MechNeurofibre</ThingDef></descriptionHyperlinks>
    <label>mech neurofibre</label>
    <description>An artificial neural fibre network woven into the mechanitor's brain to expand mechlink bandwidth capacity.\n\nThis implant can be installed up to 6 times to increase its effect (+3 bandwidth per level).</description>
    <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>6</maxSeverity>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <levelIsQuantity>true</levelIsQuantity>
    <duplicationAllowed>false</duplicationAllowed>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
      </li>
      <li>
        <minSeverity>2</minSeverity>
      </li>
      <li>
        <minSeverity>3</minSeverity>
      </li>
      <li>
        <minSeverity>4</minSeverity>
      </li>
      <li>
        <minSeverity>5</minSeverity>
      </li>
      <li>
        <minSeverity>6</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="BodyPartBionicBase">
    <defName>Tolgrim_MechNeurofibre</defName>
    <label>mech neurofibre</label>
    <description>An artificial neural fibre network that expands a mechanitor's bandwidth capacity (+3 per level, up to 6 levels).</description>
    <descriptionHyperlinks>
      <RecipeDef>Tolgrim_InstallMechNeurofibre</RecipeDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Mechlink</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>1400</MarketValue>
      <WorkToMake>28000</WorkToMake>
    </statBases>
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <researchPrerequisite>StandardMechtech</researchPrerequisite>
      <recipeUsers>
        <li>SubcoreEncoder</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Plasteel>30</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
      <SubcoreRegular>1</SubcoreRegular>
    </costList>
  </ThingDef>

  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>Tolgrim_InstallMechNeurofibre</defName>
    <label>install mech neurofibre</label>
    <description>Install a mech neurofibre implant to expand bandwidth capacity.</description>
    <descriptionHyperlinks>
      <ThingDef>Tolgrim_MechNeurofibre</ThingDef>
      <HediffDef>Tolgrim_MechNeurofibre</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing mech neurofibre.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Tolgrim_MechNeurofibre</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Tolgrim_MechNeurofibre</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Brain</li>
    </appliedOnFixedBodyParts>
    <addsHediff>Tolgrim_MechNeurofibre</addsHediff>
    <researchPrerequisite>StandardMechtech</researchPrerequisite>
  </RecipeDef>

</Defs>
