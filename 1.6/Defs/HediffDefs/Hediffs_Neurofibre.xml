      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs><li>Tolgrim_MechNeurofibreIII</li></thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

  <RecipeDef ParentName="Tolgrim_SurgeryInstallNeurofibreBase">
    <defName>Tolgrim_InstallNeurofibreIV</defName>
    <label>install mech neurofibre IV</label>
    <description>Install a mech neurofibre IV implant.</description>
    <jobString>Installing mech neurofibre IV.</jobString>
    <addsHediff>Tolgrim_NeurofibreImplantIV</addsHediff>
    <ingredients>
      <li>
        <filter><thingDefs><li>Tolgrim_MechNeurofibreIV</li></thingDefs></filter>
