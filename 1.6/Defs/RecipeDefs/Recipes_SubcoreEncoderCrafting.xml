<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Standard Subcore -->
  <RecipeDef>
    <defName>Tolgrim_CraftSubcoreRegular</defName>
    <label>make standard subcore</label>
    <description>Make a standard-tier mechanoid brain, a psychodynamic substrate unit supporting a thinking subpersona.</description>
    <jobString>Making a standard subcore.</jobString>
    <workSpeedStat>SubcoreEncodingSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>SubcoreEncoder_Working</soundWorking>
    <workAmount>3000</workAmount>
    <workSkill>Crafting</workSkill>
    <unfinishedThingDef>UnfinishedSubcore</unfinishedThingDef>
    <mechanitorOnlyRecipe>true</mechanitorOnlyRecipe>
    <researchPrerequisite>StandardMechtech</researchPrerequisite>
    <displayPriority>10</displayPriority>
    <recipeUsers>
      <li>SubcoreEncoder</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SubcoreBasic</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SubcoreBasic</li>
        <li>Steel</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>SubcoreBasic</li>
        <li>Steel</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </defaultIngredientFilter>
    <products>
      <SubcoreRegular>1</SubcoreRegular>
    </products>
  </RecipeDef>

