<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Job para la habilidad de resurrección de mecanoide -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="ResurrectionMech"]/jobDef</xpath>
    <value>
      <jobDef>Tolgrim_JobResurrectMech</jobDef>
    </value>
  </Operation>

  <!-- Recetas para resucitar y reprogramar mecanoides hostiles -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <RecipeDef ParentName="Tolgrim_BaseHostileMechanoidRecipe">
        <defName>Tolgrim_ResurrectHostileLightMech</defName>
        <label>resurrect hostile light mechanoid</label>
        <description>Resurrect a hostile light mechanoid. Its core must be reinitialized to accept new directives. Requires a basic subcore for reprogramming.</description>
        <ingredients>
          <li>
            <filter>
              <categories>
                <li>Corpses</li>
              </categories>
            </filter>
            <count>1</count>
          </li>
          <li>
            <filter>
              <thingDefs>
                <li>Steel</li>
              </thingDefs>
            </filter>
            <count>25</count>
          </li>
          <li>
            <filter>
              <thingDefs>
                <li>SubcoreBasic</li>
              </thingDefs>
            </filter>
            <count>1</count>
          </li>
        </ingredients>
        <fixedIngredientFilter>
          <thingDefs>
            <li>Corpse_Mech_Militor</li>
          </thingDefs>
        </fixedIngredientFilter>
        <researchPrerequisite>BasicMechtech</researchPrerequisite>
      </RecipeDef>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <RecipeDef ParentName="Tolgrim_BaseHostileMechanoidRecipe">
        <defName>Tolgrim_ResurrectHostileLightHMech</defName>
        <label>resurrect hostile light mechanoid (high)</label>
        <description>Resurrect a hostile light mechanoid. Its core must be reinitialized to accept new directives. Requires a high subcore for reprogramming.</description>
