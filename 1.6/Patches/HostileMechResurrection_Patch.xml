          <li>
            <filter>
              <thingDefs>
                <li>SubcoreRegular</li>
              </thingDefs>
            </filter>
            <count>1</count>
          </li>
        </ingredients>
        <fixedIngredientFilter>
          <thingDefs>
            <li>Corpse_Mech_Lancer</li>
            <li>Corpse_Mech_Pikeman</li>
            <li>Corpse_Mech_Scyther</li>
          </thingDefs>
        </fixedIngredientFilter>
        <researchPrerequisite>StandardMechtech</researchPrerequisite>
      </RecipeDef>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <RecipeDef ParentName="Tolgrim_BaseHostileMechanoidRecipe">
        <defName>Tolgrim_ResurrectHostileMediumHMech</defName>
