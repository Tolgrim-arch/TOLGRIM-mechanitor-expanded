          </li>
        </ingredients>
        <fixedIngredientFilter>
          <thingDefs>
            <li>Corpse_Mech_Apocriton</li>
            <li>Corpse_Mech_Centurion</li>
            <li>Corpse_Mech_Diabolus</li>
            <li>Corpse_Mech_Warqueen</li>
          </thingDefs>
        </fixedIngredientFilter>
        <researchPrerequisite>UltraMechtech</researchPrerequisite>
      </RecipeDef>
    </value>
  </Operation>

  <!-- Inyección de recetas en los gestadores nativos -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="MechGestator"]/recipes</xpath>
    <value>
      <li>Tolgrim_ResurrectHostileLightMech</li>
      <li>Tolgrim_ResurrectHostileLightHMech</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="LargeMechGestator"]/recipes</xpath>
    <value>
      <li>Tolgrim_ResurrectHostileMediumMech</li>
      <li>Tolgrim_ResurrectHostileMediumHMech</li>
      <li>Tolgrim_ResurrectHostileHeavyMech</li>
      <li>Tolgrim_ResurrectHostileUltraHeavyMech</li>
    </value>
  </Operation>

</Patch>
