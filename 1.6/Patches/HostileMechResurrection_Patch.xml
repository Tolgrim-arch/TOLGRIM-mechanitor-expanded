          <li>
            <filter>
              <categories>
                <li>Corpses</li>
              </categories>
            </filter>
            <count>1</count>
          </li>
          <li>
            <filter>
              <thingDefs>
                <li>Steel</li>
              </thingDefs>
            </filter>
            <count>25</count>
          </li>
          <li>
            <filter>
              <thingDefs>
                <li>SubcoreHigh</li>
              </thingDefs>
            </filter>
            <count>1</count>
          </li>
        </ingredients>
        <fixedIngredientFilter>
          <thingDefs>
            <li>Corpse_Mech_Warurchin</li>
          </thingDefs>
        </fixedIngredientFilter>
        <researchPrerequisite>HighMechtech</researchPrerequisite>
      </RecipeDef>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <RecipeDef ParentName="Tolgrim_BaseHostileMechanoidRecipe">
        <defName>Tolgrim_ResurrectHostileMediumMech</defName>
        <label>resurrect hostile medium mechanoid</label>
        <description>Resurrect a hostile medium mechanoid. Its core must be reinitialized to accept new directives. Requires a standard subcore for reprogramming.</description>
        <ingredients>
          <li>
            <filter>
