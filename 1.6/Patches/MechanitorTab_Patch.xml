<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Inyecta las pestañas ITab_Pawn_Mechanitor e ITab_Pawn_Mechanoid en BasePawn condicionalmente con Biotech -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Biotech</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[@Name="BasePawn"]/inspectorTabs</xpath>
      <value>
        <li>Tolgrim_MechanitorExpanded.ITab_Pawn_Mechanitor</li>
        <li>Tolgrim_MechanitorExpanded.ITab_Pawn_Mechanoid</li>
      </value>
    </match>
  </Operation>
</Patch>
